<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MikrotikWorker.Tests</RootNamespace>
    <AssemblyName>MikrotikWorker.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Default non-live filter: connecting live categories require explicit filter override plus env opt-in. -->
    <VSTestTestCaseFilter>Category!=Live&amp;Category!=LiveUpgrade&amp;Category!=LiveTommyOspfApplyOnly&amp;Category!=LiveAuditGate</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="tik4net.testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MikrotikWorker\MikrotikWorker.csproj" />
  </ItemGroup>

</Project>
