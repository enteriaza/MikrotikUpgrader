<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Enables Windows-host → linux-x64 Native AOT linking via bundled Zig when WSL is unavailable.
    Official Microsoft Native AOT does not support cross-OS compilation; prefer WSL/container when possible.
    Docs: https://www.nuget.org/packages/StuDev.AotAnywhere
    Official cross-compile limits: https://learn.microsoft.com/en-us/dotnet/core/deploying/native-aot/cross-compile
  -->
  <Sdk Name="StuDev.AotAnywhere" Version="1.1.0" />

  <PropertyGroup>
    <RootNamespace>MikrotikWorker</RootNamespace>
    <AssemblyName>MikrotikWorker</AssemblyName>
    <!-- Release pipeline targets only these RIDs. PublishAot is enabled by Tools/Publish-Release.ps1. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Native AOT: CsvHelper and Serilog emit IL2104 (aggregated third-party trim warnings).
    Investigated: CSV uses GetField-by-index (not GetRecords&lt;T&gt; reflection mapping);
    Serilog is not used with complex object destructuring. Do not suppress project-owned IL2026/IL3050.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MikrotikWorker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\FirmwareFiles\**\*">
      <Link>FirmwareFiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Local secrets: usable for development/output, never publish. -->
    <Content Update="appsettings.*.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="tik4net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backups are runtime data, never publish content. -->
    <Content Remove="Backups\**\*" />
    <None Include="Backups\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
