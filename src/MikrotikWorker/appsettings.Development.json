{
  "Logging": {
    "Serilog": {
      "LogDirectory": "Logs",
      "FileName": "application-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": 104857600,
      "RollOnFileSizeLimit": true,
      "MinimumLevel": "Debug",
      "WriteToConsole": true,
      "WriteToFile": true,
      "AsyncBufferCapacity": 10000,
      "AsyncBlockWhenFull": true
    }
  },
  "Listening": {
    "IpAddress": "0.0.0.0",
    "Port": 8080
  },
  "FirmwareFiles": {
    "Path": "FirmwareFiles"
  },
  "FirmwareAssessment": {
    "TargetRouterOsVersion": "6.49.23"
  },
  "Worker": {
    "HeartbeatInterval": "00:00:05"
  },
  "Mikrotik": {
    "Enabled": false,
    "Username": "your-router-username",
    "Password": "your-router-password",
    "Port": 8728,
    "ConnectionTimeout": "00:00:10",
    "ReconnectInterval": "00:00:30"
  },
  "Csv": {
    "Culture": "en-ZA",
    "TimeZoneId": "Africa/Johannesburg",
    "DateTimeFormats": [
      "dd/MM/yyyy HH:mm:ss",
      "dd/MM/yyyy HH:mm",
      "d/M/yyyy H:mm:ss",
      "d/M/yyyy H:mm",
      "yyyy/MM/dd HH:mm:ss",
      "yyyy/MM/dd HH:mm"
    ]
  },
  "ScheduledJobs": {
    "Path": "ScheduledJobs",
    "ScanInterval": "00:00:15",
    "FileReadyCheckInterval": "00:00:01",
    "FileReadyTimeout": "00:00:30",
    "MaximumFileSizeBytes": 52428800,
    "MaximumRecords": 500000,
    "MaximumPendingJobs": 10000,
    "MaxConcurrentCsvImports": 2,
    "MaxValidationErrorsRetained": 100,
    "DiscoveryQueueCapacity": 1024,
    "MaxConcurrentRouterJobs": 12
  }
}
